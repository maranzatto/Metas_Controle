rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return signedIn() && ownerUid == request.auth.uid;
    }

    function ownsVendedor(vendedorId) {
      return signedIn()
        && exists(/databases/$(database)/documents/vendedores/$(vendedorId))
        && get(/databases/$(database)/documents/vendedores/$(vendedorId)).data.ownerUid == request.auth.uid;
    }

    match /vendedores/{vendedorId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['ownerUid', 'nome', 'ativo'])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'nome', 'email', 'telefone', 'ativo', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.ativo is bool
        && (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string)
        && (!('telefone' in request.resource.data) || request.resource.data.telefone == null || request.resource.data.telefone is string);
      allow update: if isOwner(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'nome', 'email', 'telefone', 'ativo', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.nome is string
        && request.resource.data.ativo is bool;
      allow delete: if isOwner(resource.data.ownerUid);

      match /metas/{competencia} {
        allow read: if ownsVendedor(vendedorId);
        allow create, update: if ownsVendedor(vendedorId)
          && request.resource.data.categorias is map
          && request.resource.data.competencia is string;
        allow delete: if ownsVendedor(vendedorId);
      }
    }

    match /metasLoja/{competencia} {
      allow read: if isOwner(resource.data.ownerUid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.categorias is map
        && request.resource.data.competencia is string;
      allow update: if isOwner(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.categorias is map
        && request.resource.data.competencia is string;
      allow delete: if isOwner(resource.data.ownerUid);
    }

    match /vendas/{vendaId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.vendedorId is string
        && ownsVendedor(request.resource.data.vendedorId)
        && request.resource.data.categoria in [
          'POS', 'CONTROLE', 'FIXA', 'APARELHO', 'ACESSORIOS', 'NOVOS_NEGOCIOS', 'SVA'
        ]
        && request.resource.data.quantidade is number
        && request.resource.data.quantidade >= 0
        && (!('valor' in request.resource.data) || request.resource.data.valor == null || request.resource.data.valor is number)
        && request.resource.data.data is timestamp;
      allow update: if isOwner(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.vendedorId is string
        && request.resource.data.vendedorId == resource.data.vendedorId
        && ownsVendedor(request.resource.data.vendedorId)
        && request.resource.data.categoria in [
          'POS', 'CONTROLE', 'FIXA', 'APARELHO', 'ACESSORIOS', 'NOVOS_NEGOCIOS', 'SVA'
        ]
        && request.resource.data.quantidade is number
        && request.resource.data.quantidade >= 0
        && (!('valor' in request.resource.data) || request.resource.data.valor == null || request.resource.data.valor is number)
        && request.resource.data.data is timestamp;
      allow delete: if isOwner(resource.data.ownerUid);
    }
  }
}